# 复制为 .env（权限 600，已被 gitignore）。.env 绝不要提交、不要粘贴到任何公开处。
#
# ─── X (Twitter) OAuth2 —— 见 docs/DEPLOY.md 第 1 步 ───────────────────────────
# 在 https://developer.x.com 建一个 OAuth2 **Public** 应用（不需要 client secret）。
X_CLIENT_ID=
# 若你的应用是 Confidential 类型才需要（Public + PKCE 留空即可）
X_CLIENT_SECRET=
# 必须与开发者门户里登记的 Callback URL 完全一致。
# 本机无浏览器，回调经 frp 隧道发布到公网（见 docs/DEPLOY.md 第 1 步）。
X_REDIRECT_URI=https://xauth.ranlei.work/callback
# 隧道转发到的本机端口（与 ~/.config/frp/x-following-gallery.toml 的 localPort 一致）
X_CALLBACK_LOCAL_PORT=12110

# 由 `npm run authorize` 自动写入，不要手填
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_EXPIRES_AT=

# ─── Cloudflare ───────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
# 权限：Cloudflare Pages:Edit + Account Settings:Read（发布用）
CLOUDFLARE_API_TOKEN=

# ─── R2（图片托管，见 docs/DEPLOY.md 第 3 步）────────────────────────────────
# 桶名随意，但必须在 R2 里真实存在（本机部署用的是 xfg-media）
R2_BUCKET=x-following-gallery
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 的公开访问域名（独立子域），末尾不要带斜杠。
# 不要用 xxx.r2.dev（官方明说限流，仅供开发调试）。
# 例：https://img.ranlei.work
R2_PUBLIC_DOMAIN=

# ─── 可选 ─────────────────────────────────────────────────────────────────────
# Pages 项目名（`npm run publish -- --project <name>` 会自动写入）
CF_PAGES_PROJECT=x-following-gallery
# 站点上显示「策展人 · @handle」时的 handle；留空则用同步账号
X_OWNER_HANDLE=
